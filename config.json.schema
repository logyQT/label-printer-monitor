{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Printer Statistics Configuration",
  "description": "Configuration for the printer statistics collection system",
  "type": "object",
  "required": ["db_path", "log_dir", "snmp", "shifts", "printers"],
  "properties": {
    "db_path": {
      "type": "string",
      "description": "Path to SQLite database file"
    },
    "log_dir": {
      "type": "string",
      "description": "Directory for log files"
    },
    "snmp": {
      "type": "object",
      "description": "SNMP connection settings",
      "required": ["community", "timeout_sec", "retries"],
      "properties": {
        "community": {
          "type": "string",
          "description": "SNMP v2c community string",
          "default": "public"
        },
        "timeout_sec": {
          "type": "integer",
          "description": "Socket timeout in seconds",
          "minimum": 1,
          "maximum": 30,
          "default": 3
        },
        "retries": {
          "type": "integer",
          "description": "Number of retry attempts per query",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        }
      }
    },
    "shifts": {
      "type": "array",
      "description": "Work shift definitions",
      "items": {
        "type": "object",
        "required": ["name", "start", "end"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Shift name (e.g. Morning, Afternoon, Night)"
          },
          "start": {
            "type": "string",
            "description": "Shift start time (HH:MM, 24h format)",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
          },
          "end": {
            "type": "string",
            "description": "Shift end time (HH:MM, 24h format)",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      }
    },
    "printers": {
      "type": "array",
      "description": "List of printers to monitor",
      "items": {
        "type": "object",
        "required": ["ip", "model", "location"],
        "properties": {
          "ip": {
            "type": "string",
            "description": "Printer IP address",
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
          },
          "model": {
            "type": "string",
            "description": "Printer model (used to select adapter)",
            "enum": [
              "Zebra ZT230",
              "Zebra ZT411",
              "Zebra GX430t",
              "Zebra ZD621"
            ]
          },
          "location": {
            "type": "string",
            "description": "Physical location of the printer"
          },
          "meter_unit": {
            "type": "string",
            "description": "Override for meter unit (optional, auto-detected if omitted)",
            "enum": ["cm", "mm", "m", "linearMeters", "linearFeet", "sheets", "unknown"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
